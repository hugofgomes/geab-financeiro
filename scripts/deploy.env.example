# Copie este arquivo para ".env.deploy" (na raiz do projeto) (que NÃO vai para o GitHub) e preencha. Só o Claude Code neste Mac usa estes valores.

# Supabase → Connect → Session pooler. Troque [YOUR-PASSWORD] pela senha SEM os colchetes.
# Use uma senha só com letras e números (símbolos como @ # / : quebram a URL).
DATABASE_URL=

# (Opcional) Coolify → aplicação do GEAB → Webhooks → "Deploy Webhook" (URL) e um token de API em Keys & Tokens.
COOLIFY_DEPLOY_URL=
COOLIFY_TOKEN=
